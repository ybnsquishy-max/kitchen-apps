{
  "name": "Dash",
  "short_name": "Dash",
  "description": "Car mode for your phone: maps, music, calls and messages with big buttons.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0A0F13",
  "theme_color": "#0A0F13",
  "icons": [
    {
      "src": "icons/icon-192-neon.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png?v=neon",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png?v=neon",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg?v=neon",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "./share-contact",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "card",
          "accept": [
            "text/vcard",
            "text/x-vcard",
            "text/directory",
            ".vcf",
            ".vcard"
          ]
        }
      ]
    }
  }
}
